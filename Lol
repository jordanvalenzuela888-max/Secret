-- =============================================
-- TAB SWITCHING LOGIC (White borders, gray text always)
-- =============================================

local function switchTab(tabName)
	if tabName == "Logs" then
		logsTab.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		configTab.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		logsTab.TextColor3 = Color3.fromRGB(180, 180, 180)
		configTab.TextColor3 = Color3.fromRGB(180, 180, 180)
		logsStroke.Color = Color3.fromRGB(255, 255, 255) -- WHITE active
		configStroke.Color = Color3.fromRGB(60, 60, 60) -- Dark inactive
		logsContent.Visible = true
		configContent.Visible = false
	else
		logsTab.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
		configTab.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		logsTab.TextColor3 = Color3.fromRGB(180, 180, 180)
		configTab.TextColor3 = Color3.fromRGB(180, 180, 180)
		logsStroke.Color = Color3.fromRGB(60, 60, 60) -- Dark inactive
		configStroke.Color = Color3.fromRGB(255, 255, 255) -- WHITE active
		logsContent.Visible = false
		configContent.Visible = true
	end
end

logsTab.MouseButton1Click:Connect(function()
	switchTab("Logs")
end)

configTab.MouseButton1Click:Connect(function()
	switchTab("Config")
end)

-- Set default active tab
switchTab("Logs")

-- =============================================
-- MINIMIZE LOGIC
-- =============================================

local opened = true
local openedSize = UDim2.new(0, 350, 0, 500)
local closedSize = UDim2.new(0, 350, 0, 32)

minimize.MouseButton1Click:Connect(function()
	opened = not opened

	if opened then
		frame.Size = openedSize
		logsContent.Visible = (logsStroke.Color == Color3.fromRGB(255, 255, 255))
		configContent.Visible = (configStroke.Color == Color3.fromRGB(255, 255, 255))
		tabBar.Visible = true
		minimize.Text = "-"
	else
		frame.Size = closedSize
		logsContent.Visible = false
		configContent.Visible = false
		tabBar.Visible = false
		minimize.Text = "+"
	end
end)

-- =============================================
-- AQUA GLOWING RACETRACK BORDER
-- =============================================

local function addRacetrackBorder(targetFrame)
    if not targetFrame or not targetFrame:IsA("Frame") then return end

    local stroke = Instance.new("UIStroke")
    stroke.Name = "RacetrackBorder"
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Thickness = 6
    stroke.Color = Color3.fromRGB(0, 255, 255)
    stroke.Transparency = 0.15
    stroke.Parent = targetFrame

    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0,   Color3.fromRGB(0, 25, 25)),
        ColorSequenceKeypoint.new(0.3, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 255, 255)),
        ColorSequenceKeypoint.new(0.7, Color3.fromRGB(0, 255, 255)),
        ColorSequenceKeypoint.new(1,   Color3.fromRGB(0, 25, 25)),
    }
    grad.Parent = stroke

    local startTime = tick()
    local conn

    conn = RunService.Heartbeat:Connect(function()
        if not targetFrame.Parent then
            conn:Disconnect()
            return
        end

        local W = targetFrame.AbsoluteSize.X
        local H = targetFrame.AbsoluteSize.Y
        if W <= 0 or H <= 0 then return end

        local perim = (W + H) * 2
        local elapsed = (tick() - startTime) % 2.7
        local progress = elapsed / 2.7
        local dist = (progress * perim) % perim
        local rot = 0

        if dist < W then
            rot = (dist / W) * 90
        elseif dist < W + H then
            rot = 90 + ((dist - W) / H) * 90
        elseif dist < W*2 + H then
            rot = 180 + ((dist - W - H) / W) * 90
        else
            rot = 270 + ((dist - W*2 - H) / H) * 90
        end

        grad.Rotation = rot

        local wave = math.sin(progress * math.pi * 2)
        stroke.Transparency = 0.05 + wave * 0.25
        stroke.Thickness = 6 + math.sin(tick() * 8) * 0.3
    end)
end

addRacetrackBorder(frame)
